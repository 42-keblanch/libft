{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "test",
      "type": "shell",
      "command": "make -C tests test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": ["relative", "${workspaceFolder}/tests"]
      },
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "build lib",
      "type": "shell",
      "command": "make",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "build test",
      "type": "shell",
      "command": "make -C tests",
      "problemMatcher": "$gcc"
    }
  ]
}
